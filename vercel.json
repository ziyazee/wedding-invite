{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/arjunbhavana",
      "destination": "/arjunbhavana.html"
    },
    {
      "source": "/arjunbhavana/",
      "destination": "/arjunbhavana.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/design14",
      "destination": "/arjunbhavana",
      "permanent": true
    },
    {
      "source": "/design14/",
      "destination": "/arjunbhavana",
      "permanent": true
    },
    {
      "source": "/design14/index.html",
      "destination": "/arjunbhavana",
      "permanent": true
    }
  ]
}
